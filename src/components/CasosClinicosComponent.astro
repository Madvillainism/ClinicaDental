		gap: 20px;
		margin-top: 50px;
	}

	#cards-container {
		display: flex;
		flex-direction: row;
		gap: 20px;

  /* The main card container */
  .card {
    background: #ffffff;
    border-radius: 1.5rem;
    padding: 1rem;
    max-width: 300px;
	max-height: 250px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    border: 1px solid #f0f0f0;
    transition: transform 0.3s ease;
  }

  .card:hover {
    transform: translateY(-5px);
  }

  /* Stars container */
  .card > div:first-child {
    color: #FFC107; /* Gold color for stars */
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
    letter-spacing: 2px;
  }

  /* The testimonial quote text */
  .card > p {
    font-size: 1.125rem;
    line-height: 1.7;
    color: #334155;
    font-style: italic;
    margin-bottom: 2rem;
    position: relative;
  }

  /* Author section container */
  .card > div:last-child {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid #f1f5f9;
    padding-top: 1.5rem;
  }

  /* Patient Avatar */
  .card img {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    object-fit: cover;
    background-color: #e2e8f0; /* Fallback color */
  }

  /* Patient Name */
  .card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
  }

  /* Patient Subtitle (Since 2005) */
  .card div p {
    font-size: 0.875rem;
    color: #64748b;
    margin: 0;
  }


