  .carousel-container {
    padding: 2rem;
    width: 85%;
    margin: 0 auto;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
  }

  .controls button {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    border: 1px solid #ddd;
    background: white;
    cursor: pointer;
    font-size: 1.2rem;
    transition: all 0.2s;
  }

  .controls button:hover {
    background: #f0f0f0;
    transform: scale(1.05);
  }

  .carousel-track {
    display: flex;
	flex-direction: row;
    gap: 1.5rem;
	height: 400px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Hides scrollbar on Firefox */
    scroll-behavior: smooth;
  }

  .carousel-track::-webkit-scrollbar {
    display: none; /* Hides scrollbar on Chrome/Safari */
  }

  .card-wrapper {
    scroll-snap-align: start;
	display: flex;
    flex-direction: row;
    scroll-snap-align: start;
    gap: 20px;
    flex-wrap: wrap;
  }

  /* Your existing card styles from before... */
