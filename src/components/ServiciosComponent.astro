<style>
  #container {
    font-family:
      Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
      sans-serif;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  header {
    width: 90%;
    height: 4em;
    display: flex;
    align-items: center;
    padding: 20px;
    gap: 20px;
  }
  nav {
    display: flex;
    gap: 2em;
    flex-grow: 1;
    justify-content: center;
    align-items: center;

    a {
      font-size: 18px;
      text-decoration: none;
      color: black;
      padding: 0.25em;
    }

    a:nth-child(1) {
      border-bottom: 2px solid black;
      padding: 0.15em;
    }
  }
  .boton-cita {
    background-color: #2f3339;
    border: none;
    padding: 15px 20px;
    border-radius: 25px;
    cursor: pointer;
  }
  .boton-cita a {
    color: white;
    font-size: 18px;
    text-decoration: none;
  }

  main {
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: white;
  }

  h1 {
    font-size: 46px;

    margin-top: 0.25em;
    font-weight: 400;
    margin-bottom: 0;
  }
  p {
    font-size: 18px;
    margin-top: 0.5em;
    max-width: 600px;
    text-align: center;
  }

  #lower-buttons {
    margin-top: 50px;
    display: flex;
    gap: 30em;
    width: 100%;
    justify-content: space-between;

    .icon-box {
      display: flex;
      flex-direction: row;
      width: 90%;
      align-items: center;
      justify-content: space-between;
    }

    .text-box {
      text-align: left;
      padding: 0 1em;
      width: 80%;
      p {
        text-align: left;
      }
    }

    .hero-cta {
      display: flex;
      border-radius: 15px;
      background-color: #b0b6c1;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      height: 15em;
      gap: 1em;
    }
  }

  #hero {
    display: flex;
    align-items: center;
    flex-direction: row;
    justify-content: space-evenly;
    background-image: linear-gradient(to top, #a1a7b3, #d0d5e0);
    height: 450px;
    width: 100%;
  }

  #hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;

    p {
      width: 500px;
      text-align: center;
      font-size: 16px;
    }

    h1 {
      width: 620px;
      margin-top: 0;
      text-align: center;
      color: black;
    }

    .boton-hero {
      background-color: #fefeff;
      border: none;
      padding: 15px 20px;
      border-radius: 10px;
      width: 175px;
      cursor: pointer;
      font-size: 16px;
    }
  }

  #links {
    display: flex;
    gap: 16px;
  }

  #links a {
    display: flex;
    align-items: center;
    padding: 10px 12px;
    color: #111827;
    text-decoration: none;
    transition: color 0.2s;
  }

  #links a:hover {
    color: rgb(78, 80, 86);
  }

  #links a svg {
    height: 1em;
    margin-left: 8px;
  }

  #links a.button {
    color: white;
    background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      inset 0 -2px 0 rgba(0, 0, 0, 0.24);
    border-radius: 10px;
  }

  #links a.button:hover {
    color: rgb(230, 230, 230);
    box-shadow: none;
  }

  #info {
    width: 90%;
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-top: 50px;
    border-bottom: 1px solid black;

    h2 {
      text-align: left;
    }

    p {
      color: black;
    }
  }

  #info-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 80%;

    h1 {
      color: black;
    }

    p {
      text-align: left;
    }

    button {
      background-color: #2f3339;
      border: none;
      padding: 5px 10px;
      border-radius: 10px;
      cursor: pointer;
      color: white;
      width: 120px;
      font-size: 18px;
      justify-self: end;
    }
  }

  #testimonios {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 50px;
  }

  #cards-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    padding-bottom: 30px;

    /* The main card container */
    .card {
      display: flex;
      flex-direction: column;
      text-align: left;
      align-items: flex-start;
      background: #bdbdbd;
      border-radius: 15px;
      max-width: 300px;
      height: 400px;
      max-height: 500px;
      transition: transform 0.3s ease;
      gap: 25px;
      img {
        align-self: center;
      }
    }

    .card-text {
      display: flex;
      flex-direction: column;
      gap: 15px;
      padding: 20px;

      h2 {
        margin-bottom: 0;
      }

      p {
        text-align: left;
        font-size: 16px;
        width: 90%;
      }
    }

    .card:hover {
      transform: translateY(-5px);
    }

    .boton-card {
      background-color: #f4f4f4;
      border: none;
      padding: 5px 5px;
      border-radius: 10px;
      cursor: pointer;
      color: black;
      width: 150px;
      font-size: 18px;
      justify-self: end;
    }
  }

  footer {
    background-color: #3c3a3a;
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    height: 360px;
    align-items: center;
  }

  #footer-info {
    display: flex;
    flex-direction: row;
    justify-content: center;
    gap: 50px;
    margin-bottom: 30px;
    width: 85%;

    p {
      color: white;
      margin: 0;
      font-size: 14px;
      text-align: left;
    }
  }

  #footer-info-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 30%;
    justify-content: center;
  }

  #footer-info-right {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    gap: 80px;
    width: 70%;

    .footer-text-container {
      display: flex;
      flex-direction: column;
      gap: 10px;
      width: 20%;

      h4 {
        margin: 0;
      }

      a {
        color: white;
        text-decoration: none;
        font-size: 14px;
      }

      a:hover {
        text-decoration: underline;
      }
    }
  }

  .user-policy {
    border-top: 2px solid white;
    padding-top: 20px;
    display: flex;
    flex-direction: row;
    width: 85%;
    justify-content: space-between;
    p {
      font-size: 12px;
      margin: 0;
    }
  }

  pre {
    font-family:
      ui-monospace, "Cascadia Code", "Source Code Pro", Menlo, Consolas,
      "DejaVu Sans Mono", monospace;
    font-weight: normal;
    background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
  }

  code {
    display: inline-block;
    background:
      linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
      linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
    border-radius: 8px;
    border: 1px solid transparent;
    padding: 6px 8px;
  }

  .box {
    padding: 16px;
    background: rgba(255, 255, 255, 1);
    border-radius: 16px;
    border: 1px solid white;
  }

  #news {
    position: absolute;
    bottom: 16px;
    right: 16px;
    max-width: 300px;
    text-decoration: none;
    transition: background 0.2s;
    backdrop-filter: blur(50px);
  }

  #news:hover {
    background: rgba(255, 255, 255, 0.55);
  }

  @media screen and (max-height: 368px) {
    #news {
      display: none;
    }
  }

  @media screen and (max-width: 768px) {
    #container {
      display: flex;
      flex-direction: column;
    }

    #hero {
      display: block;
      padding-top: 10%;
    }

    #links {
      flex-wrap: wrap;
    }

    #links a.button {
      padding: 14px 18px;
    }

    #news {
      right: 16px;
      left: 16px;
      bottom: 2.5rem;
      max-width: 100%;
    }

    h1 {
      line-height: 1.5;
    }
  }
</style>

<script>
  const track = document.getElementById("track");
  const nextBtn = document.getElementById("next");
  const prevBtn = document.getElementById("prev");

  // How much to scroll (Card width + Gap)
  const scrollAmount = 350 + 24;

  nextBtn?.addEventListener("click", () => {
    track?.scrollBy({ left: scrollAmount, behavior: "smooth" });
  });

  prevBtn?.addEventListener("click", () => {
    track?.scrollBy({ left: -scrollAmount, behavior: "smooth" });
  });
</script>
